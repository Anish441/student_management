
pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME = 'attendance'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir('attendance') {
                    sh 'mvn clean verify'
                }
            }
            post {
                always {
                    dir('attendance') {
                        script {
                            if (fileExists('target/surefire-reports')) {
                                junit(
                                    testResults: 'target/surefire-reports/TEST-*.xml',
                                    allowEmptyResults: true
                                )
                            } else {
                                echo 'No test reports found.'
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('attendance') {
                    sh '''
                        docker build \
                            -t $IMAGE_NAME:$BUILD_NUMBER \
                            -t $IMAGE_NAME:latest .
                    '''
                }
            }
        }

        stage('Archive Build Result') {
            steps {
                archiveArtifacts(
                    artifacts: 'attendance/target/*.jar',
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {
        success {
            echo 'Build and Docker image creation successful!'
        }
        failure {
            echo 'Build failed. Check the stage logs.'
        }
    }
}
